{
  "manifest_version": 3,
  "name": "Voice Input - Casier Frais",
  "version": "1.5.1",
  "description": "Saisie vocale des champs de poids via ElevenLabs Scribe v2 + Gemini Flash",
  "update_url": "https://raw.githubusercontent.com/thoy-le-duc/voice-input-extension/main/dist/update.xml",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.elevenlabs.io/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Input - Réglages"
  }
}
